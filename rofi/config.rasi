@import "colors.rasi"

/* --- COMPORTAMENTO --- */
configuration {
    modi: "drun";
    show-icons: true;
    icon-theme: "Papirus-Dark"; /* Mude pro tema de ícones que vc usa */
    font: "FiraCode Nerd Font 12";
    drun-display-format: "{name}";
}

/* --- ESTILO GLOBAL --- */
* {
    /* Define o fundo transparente por padrão pra não bugar as bordas */
    background-color: transparent; 
    text-color: @fg;
    margin: 0;
    padding: 0;
}

/* --- A JANELA PRINCIPAL --- */
window {
    width: 600px;
    background-color: @bg;
    border: 2px solid;
    border-color: @accent; /* A borda vai usar a cor de destaque do seu wallpaper! */
    border-radius: 12px;
    padding: 15px;
}

/* A caixa que guarda tudo dentro da janela */
mainbox {
    spacing: 15px;
}

/* --- BARRA DE PESQUISA --- */
inputbar {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 12px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font: "FiraCode Nerd Font Bold 12";
}

entry {
    placeholder: "Pesquisar...";
    placeholder-color: @muted;
    text-color: @fg;
}

/* --- LISTA DE APLICATIVOS --- */
listview {
    lines: 7; /* Quantos apps mostram por vez */
    spacing: 5px;
    scrollbar: false;
    border: 0px; /* Tira aquela linha separadora padrão do Rofi */
}

/* --- CADA ITEM DA LISTA --- */
element {
    padding: 10px;
    border-radius: 8px;
    spacing: 10px;
}

element-icon {
    size: 24px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit; /* Herda a cor do elemento pra quando for selecionado */
}

/* --- ITEM SELECIONADO --- */
element selected {
    background-color: @fg;
    text-color: @blue; /* Muda a cor do texto do app selecionado */
}
